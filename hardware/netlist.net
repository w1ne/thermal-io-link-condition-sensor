(export (version "E")
 (design (source "hardware/wiring.md"))
 (components
  (comp (ref "MCU") (value "ESP32-C3-DevKitM-1"))
  (comp (ref "SENSOR") (value "MLX90640 3.3V breakout"))
  (comp (ref "PHY") (value "STEVAL-IOD003V1 L6362A"))
  (comp (ref "MASTER") (value "IO-Link master port")))
 (nets
  (net (code "1") (name "SDA") (node (ref "MCU") (pin "GPIO0")) (node (ref "SENSOR") (pin "SDA")))
  (net (code "2") (name "SCL") (node (ref "MCU") (pin "GPIO1")) (node (ref "SENSOR") (pin "SCL")))
  (net (code "3") (name "IN2_TX") (node (ref "MCU") (pin "GPIO4")) (node (ref "PHY") (pin "CN5.3")))
  (net (code "4") (name "OUTIQ_RX") (node (ref "MCU") (pin "GPIO5")) (node (ref "PHY") (pin "CN9.3")))
  (net (code "5") (name "EN") (node (ref "MCU") (pin "GPIO6")) (node (ref "PHY") (pin "CN5.2")))
  (net (code "6") (name "OL") (node (ref "MCU") (pin "GPIO7")) (node (ref "PHY") (pin "CN5.5")))
  (net (code "7") (name "DIAG") (node (ref "MCU") (pin "GPIO10")) (node (ref "PHY") (pin "CN8.3")))
  (net (code "8") (name "CQ_24V_PHY_ONLY") (node (ref "PHY") (pin "CN1.4")) (node (ref "MASTER") (pin "4")))
  (net (code "9") (name "LPLUS") (node (ref "PHY") (pin "CN1.1")) (node (ref "MASTER") (pin "1")))
  (net (code "10") (name "COMMON_GROUND") (node (ref "MCU") (pin "GND")) (node (ref "SENSOR") (pin "GND")) (node (ref "PHY") (pin "CN6.6")) (node (ref "PHY") (pin "IN1 after R102 removal")) (node (ref "MASTER") (pin "3")))
  (net (code "11") (name "MCU_3V3_ONLY") (node (ref "MCU") (pin "3V3")) (node (ref "SENSOR") (pin "VCC")))))
