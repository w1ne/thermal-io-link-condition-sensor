(export (version "E")
  (design (source "Thermal IO-Link Condition Sensor.kicad_sch"))
  (components
    (comp (ref "thermal-mcu")
      (value "ESP32-C3 SUPERMINI")
      (footprint "")
      (libsource (lib "MCU") (part "ESP32-C3 SUPERMINI"))
    )
    (comp (ref "thermal-cam")
      (value "MLX90640")
      (footprint "")
      (libsource (lib "SENSOR") (part "MLX90640"))
    )
    (comp (ref "thermal-m12")
      (value "M12 IO-LINK CONNECTOR")
      (footprint "")
      (libsource (lib "CONNECTOR") (part "M12 IO-LINK CONNECTOR"))
    )
    (comp (ref "thermal-reg")
      (value "24V -> 3V3 REGULATOR")
      (footprint "")
      (libsource (lib "POWER") (part "24V -> 3V3 REGULATOR"))
    )
  )
  (nets
    (net (code "1") (name "I2C_thermal-mcu_thermal-cam")
      (node (ref "thermal-mcu") (pin "sda"))
      (node (ref "thermal-cam") (pin "sda"))
    )
    (net (code "2") (name "I2C_thermal-mcu_thermal-cam")
      (node (ref "thermal-mcu") (pin "scl"))
      (node (ref "thermal-cam") (pin "scl"))
    )
    (net (code "3") (name "IO-LINK C/Q_thermal-mcu_thermal-m12")
      (node (ref "thermal-mcu") (pin "cq"))
      (node (ref "thermal-m12") (pin "cq"))
    )
    (net (code "4") (name "DC 24V_thermal-m12_thermal-reg")
      (node (ref "thermal-m12") (pin "lplus"))
      (node (ref "thermal-reg") (pin "vin"))
    )
    (net (code "5") (name "GROUND_thermal-m12_thermal-reg")
      (node (ref "thermal-m12") (pin "lminus"))
      (node (ref "thermal-reg") (pin "gnd"))
    )
    (net (code "6") (name "DC 3.3V_thermal-reg_thermal-mcu")
      (node (ref "thermal-reg") (pin "vout"))
      (node (ref "thermal-mcu") (pin "3v3"))
    )
    (net (code "7") (name "DC 3.3V_thermal-reg_thermal-cam")
      (node (ref "thermal-reg") (pin "vout"))
      (node (ref "thermal-cam") (pin "vcc"))
    )
    (net (code "8") (name "GROUND_thermal-m12_thermal-mcu")
      (node (ref "thermal-m12") (pin "lminus"))
      (node (ref "thermal-mcu") (pin "gnd"))
    )
    (net (code "9") (name "GROUND_thermal-m12_thermal-cam")
      (node (ref "thermal-m12") (pin "lminus"))
      (node (ref "thermal-cam") (pin "gnd"))
    )
  )
)